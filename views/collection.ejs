<%- include ('partials/header') %>
    <script src="/scripts/collection/collection.js" defer></script>
    <title>Collection</title>

    <%- include ('partials/navigation') %>

   <main class="flex-1 pt-12 sm:px-5 lg:px-8 pb-6">

      <div
        class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6"
      >

        <div
          id="alertBox"
          class="hidden fixed top-20 right-3 sm:right-6 z-50 p-4 rounded-xl text-sm bg-green-900 text-green-300 border border-green-700 shadow-lg"
        >
        </div>

        <form method="GET" action="/collection">
          <select
            name="sort"
            onchange="this.form.submit()"
            class="w-full sm:w-auto bg-slate-800 border border-slate-600 rounded-xl px-4 py-2 text-white outline-none focus:border-indigo-500 transition"
          >
            <option value="">Sorteer op</option>

            <option value="rating" <%= sort === "rating" ? "selected" : "" %>>
              Rating hoog → laag
            </option>

            <option value="ratingAsc" <%= sort === "ratingAsc" ? "selected" : "" %>>
              Rating laag → hoog
            </option>

            <option value="name" <%= sort === "name" ? "selected" : "" %>>
              Naam A → Z
            </option>

            <option value="released" <%= sort === "released" ? "selected" : "" %>>
              Nieuwste release
            </option>
          </select>
        </form>
      </div>

      <section
        class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5"
      >
        <% if (games.length === 0) { %>

          <p class="text-slate-300">
            Je collectie is leeg.
          </p>

        <% } %>

        <% games.forEach(game => { %>

          <article>
            <figure
              class="relative border border-slate-700 rounded-2xl overflow-hidden hover:border-indigo-500 transition bg-slate-800 shadow-lg"
            >
              <button
                class="deleteBtn absolute top-3 right-3 z-10 bg-black/60 hover:bg-red-600 transition p-2 rounded-full backdrop-blur-sm"
                data-id="<%= game.id %>"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="size-5 text-white"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 18 18 6M6 6l12 12"
                  />
                </svg>
              </button>

              <img
                src="<%= game.background_image %>"
                alt="<%= game.name %>"
                class="w-full object-cover aspect-video"
              />

              <figcaption
                class="p-4 text-center font-medium text-sm sm:text-base"
              >
                <%= game.name %>
              </figcaption>

            </figure>
          </article>

        <% }) %>
      </section>
    </main>

<%- include ('partials/footer') %>