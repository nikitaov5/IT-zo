<%- include('partials/header') %>
<title>GameHub</title>

<script type="module" src="/scripts/main-page/index.js" defer></script>

<%- include('partials/navigation') %>

<main class="flex-1 pt-16 px-3 sm:px-5 lg:px-8 pb-6 grid grid-cols-12 gap-4 sm:gap-6">
  <div class="col-span-12 grid grid-cols-12 items-center gap-4 mb-4">
    
    <div class="col-span-12 sm:col-span-4 flex justify-start">
      <select
        id="sortGames"
        class="bg-slate-800 border border-slate-600 rounded-xl px-4 py-2 text-white outline-none focus:border-indigo-500 transition w-full sm:w-auto"
      >
        <option value="">Sorteer op</option>
        <option value="ratingDesc">Rating hoog → laag</option>
        <option value="ratingAsc">Rating laag → hoog</option>
        <option value="name">Naam A → Z</option>
        <option value="released">Nieuwste release</option>
      </select>
    </div>

    <div class="col-span-12 sm:col-span-4 flex items-center justify-center gap-3 sm:gap-4">
      <button
        id="prevPage"
        class="px-3 sm:px-4 py-2 text-slate-800 rounded hover:scale-110 transition"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="white"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18"
          />
        </svg>
      </button>

      <span id="pageNumber" class="font-bold text-sm sm:text-base text-white">
        1
      </span>

      <button
        id="nextPage"
        class="px-3 sm:px-4 py-2 text-slate-800 rounded hover:scale-110 transition"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="white"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3"
          />
        </svg>
      </button>
    </div>

    <div class="hidden sm:block sm:col-span-4"></div>
  </div>

  <div
  id="gamesGrid"
  class="order-2 lg:order-1 col-span-12 lg:col-span-8 grid gap-4 sm:gap-6 grid-cols-[repeat(auto-fit,minmax(200px,1fr))] sm:grid-cols-[repeat(auto-fit,260px)] place-content-start justify-center">
    <% games.forEach(game => { %>

    <div
      class="cursor-pointer border-2 border-slate-700 rounded-xl overflow-hidden shadow-2xl
         transition hover:scale-[1.02] hover:border-indigo-500
         flex flex-col h-80 max-w-[260px] w-full mx-auto"
      >
      <div class="w-full aspect-[16/9] overflow-hidden flex-shrink-0">
        <img
          src="<%= game.background_image %>"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="p-3">
        <h3
          class="font-semibold text-sm line-clamp-2 text-slate-50 text-center"
        >
          <%= game.name %>
        </h3>
      </div>
    </div>

    <% }) %>
  </div>

  <div
    id="alertBox"
    class="hidden fixed top-24 right-4 z-50 p-4 rounded text-sm"
  ></div>

  <div
    class="order-1 lg:order-2 col-span-12 lg:col-span-4 lg:sticky lg:top-32 h-fit"
  >
    <div
      class="bg-slate-800/60 backdrop-blur-md border border-slate-700/50 rounded-2xl p-6 shadow-2xl text-slate-100"
    >
      <div class="text-center mb-6">
        <h2 id="gameName" class="text-lg sm:text-xl font-bold mb-4 sm:mb-6"></h2>

        <img
          id="gameImage"
          class="w-full max-w-md lg:max-w-full rounded-lg mb-4 mx-auto"
        />

        <p class="mb-4 text-slate-400">Kies een game</p>
      </div>

      <div class="flex flex-col gap-3 mb-6">
        <button
          data-action="add-collection"
          class="w-full flex items-center justify-center gap-2 px-5 sm:px-6 py-3 font-bold rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 shadow-md transition"
        >
          Toevoegen aan collectie
        </button>

        <button
          data-action="set-current"
          class="w-full flex items-center justify-center gap-2 px-5 sm:px-6 py-3 font-bold rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 shadow-md transition"
        >
          Als huidige game aanduiden
        </button>
      </div>

      <div
        class="space-y-2 text-center border-t border-slate-700/50 pt-4 text-sm sm:text-base"
      >
        <p id="gameRelease"></p>
        <p id="gamePlaytime" class="mt-3 sm:mt-4"></p>
        <p id="gameRating"></p>
        <p id="gamePlatform"></p>
        <p id="gameGenre"></p>
        <p id="gameStore"></p>
      </div>
    </div>
  </div>
</main>


<%- include('partials/footer') %>