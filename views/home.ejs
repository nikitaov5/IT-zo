<%- include('partials/header') %>
<title>GameHub</title>
<script type="module" src="/scripts/main-page/index.js" defer></script>

<header class="fixed top-0 right-0 left-0 bg-slate-200 text-slate-800 flex items-center gap-6 p-4 z-50">
  <nav class="flex gap-10">
    <a href="/home">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
    </a>
    <a href="/collection">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
      </svg>
    </a>
    <a href="/compare">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
      </svg>
    </a>
    <a href="/gtg">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959-.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" />
      </svg>
    </a>
  </nav>

  <div class="ml-auto flex items-center gap-4">
    <div id="currentGame" class="hidden items-center gap-2">
      <img id="currentGameImage" class="w-8 h-8 rounded object-cover border border-slate-400" alt="" />
      <span id="currentGameName" class="text-sm font-semibold text-slate-800 truncate max-w-32"></span>
    </div>

    <div class="relative w-64">
      <input type="text" id="searchInput" placeholder="Zoek een game..." class="w-full rounded-full bg-slate-100 border border-slate-300 px-4 py-2 pl-10 focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:bg-white transition text-slate-800 placeholder-slate-400" />
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z" />
      </svg>
    </div>
  </div>
</header>

<main class="mt-20 p-8 grid grid-cols-12 gap-8">
  <div class="col-span-12 lg:col-span-8 flex items-center justify-center gap-4 mb-4">
    <button id="prevPage" class="px-4 py-2 text-slate-800 rounded hover:scale-110 transition">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 15.75 3 12m0 0 3.75-3.75M3 12h18" />
      </svg>
    </button>

    <span id="pageNumber" class="font-bold">1</span>

    <button id="nextPage" class="px-4 py-2 text-slate-800 rounded hover:scale-110 transition">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3" />
      </svg>
    </button>
  </div>

  <div id="gamesGrid" class="order-2 lg:order-1 col-span-12 lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6"> 
    <% games.forEach(game => { %>
      <div class="cursor-pointer border-2 border-slate-700 rounded-xl overflow-hidden shadow-2xl transition hover:scale-[1.02] hover:border-indigo-500">
        <div class="w-full aspect-[16/9] overflow-hidden">
          <img src="<%= game.background_image %>" class="w-full h-full object-cover" />
        </div>
        <div class="p-3">
          <h3 class="font-semibold text-sm line-clamp-2 text-slate-50 text-center">
            <%= game.name %>
          </h3>
        </div>
      </div>
    <% }) %>
  </div>

  <div class="order-1 lg:order-2 col-span-12 lg:col-span-4 lg:sticky lg:top-32 h-fit">
    <div class="bg-slate-800/60 backdrop-blur-md border border-slate-700/50 rounded-2xl p-6 shadow-2xl text-slate-100">
      
      <div class="text-center mb-6">
        <h2 id="gameName" class="text-xl font-bold mb-4"></h2>
        <img id="gameImage" class="w-full rounded-lg mb-4" />
        <p class="bottom-4 mb-4 text-slate-400">Kies een game</p>
      </div>

      <div class="flex flex-col gap-3 mb-6">
        <button data-action="add-collection" class="w-full flex items-center justify-center gap-2 px-6 py-3 font-bold rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 shadow-md transition">
          Toevoegen aan collectie
        </button>
        <button data-action="set-current" class="w-full flex items-center justify-center gap-2 px-6 py-3 font-bold rounded-xl bg-slate-200 hover:bg-slate-300 text-slate-800 shadow-md transition">
          Als huidige game aanduiden
        </button>
      </div>

      <div class="space-y-2 text-center border-t border-slate-700/50 pt-4">
        <p id="gameRelease"></p>
        <p id="gamePlaytime" class="mt-4"></p>
        <p id="gameRating"></p>
        <p id="gamePlatform"></p>
        <p id="gameGenre"></p>
        <p id="gameStore"></p>
      </div>

    </div>
  </div>
</main>

<footer class="bg-neutral-primary-soft rounded-base mt-auto border-t border-slate-700/30">
  <div class="w-full mx-auto max-w-screen-xl p-6 flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
    <span class="text-sm text-body">
      © 2026 <a href="/home" class="hover:underline font-semibold text-indigo-400">IT&Zo™</a>. All Rights Reserved.
    </span>
    <ul class="flex flex-wrap items-center justify-center gap-6 text-sm font-medium text-body">
      <li><a href="#" class="hover:text-indigo-400 transition hover:underline">About</a></li>
      <li><a href="#" class="hover:text-indigo-400 transition hover:underline">Privacy Policy</a></li>
      <li><a href="#" class="hover:text-indigo-400 transition hover:underline">Licensing</a></li>
    </ul>
  </div>
</footer>

<%- include('partials/footer') %>