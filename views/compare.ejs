<%- include ('partials/header') %>
<title>Compare</title>

<script type="module" src="/scripts/compare/compare.js" defer></script>

<%- include ('partials/navigation') %>

<!-- Main -->
<main
  class="flex-1 max-w-7xl mx-auto px-3 sm:px-5 lg:px-8 pt-24 flex flex-col lg:flex-row gap-4 sm:gap-6"
>
  <!-- Game 1 -->
  <section
    id="game_card_1"
    class="w-full bg-slate-900 text-sm sm:text-base text-slate-100 shadow-lg overflow-hidden border border-slate-700 rounded-lg"
  >
    <img
      src="../assets/images/no-cover.png"
      alt=""
      class="w-full aspect-video object-cover rounded-lg"
      id="gameImg"
    />

    <div class="px-4 sm:px-5 py-3 sm:py-4 flex flex-col gap-3">
      <h2 id="gameName" class="text-lg font-bold text-white">
        Game Naam
      </h2>

      <ul class="flex flex-col gap-1.5 text-sm text-slate-400">
        <li id="gameGenre">Genre</li>
        <li id="gameRelease">Release</li>
        <li id="gamePlatform">Platform</li>
        <li id="gameRating" class="text-amber-400 font-semibold">
          Rating
        </li>
      </ul>

      <input
        type="search"
        placeholder="Zoek een game..."
        class="mt-1 w-full bg-slate-900 text-slate-100 placeholder-slate-500 rounded-lg px-4 py-2 text-sm outline-none border border-slate-700 focus:border-blue-400 transition"
      />
    </div>
  </section>

  <!-- Game 2 -->
  <section
    id="game_card_2"
    class="w-full bg-slate-900 text-sm sm:text-base text-slate-100 shadow-lg overflow-hidden border border-slate-700 rounded-lg"
  >
    <img
      src="../assets/images/no-cover.png"
      alt=""
      class="w-full aspect-video object-cover rounded-lg"
      id="gameImg2"
    />

    <div class="px-4 sm:px-5 py-3 sm:py-4 flex flex-col gap-3">
      <h2 id="gameName2" class="text-lg font-bold text-white">
        Game Naam
      </h2>

      <ul class="flex flex-col gap-1.5 text-sm text-slate-400">
        <li id="gameGenre2">Genre</li>
        <li id="gameRelease2">Release</li>
        <li id="gamePlatform2">Platform</li>
        <li id="gameRating2" class="text-amber-400 font-semibold">
          Rating
        </li>
      </ul>

      <input
        type="search"
        placeholder="Zoek een game..."
        class="mt-1 w-full bg-slate-900 text-slate-100 placeholder-slate-500 rounded-lg px-4 py-2 text-sm outline-none border border-slate-700 focus:border-blue-400 transition"
      />
    </div>
  </section>
</main>

        <li id="gameRating" class="text-amber-400 font-semibold">Rating</li>
      </ul>
      <!-- Dropdown -->
      <div class="relative">
        <input
          type="search"
          id="searchInput1"
          placeholder="Zoek een game..."
          class="mt-1 w-full bg-slate-900 text-slate-100 placeholder-slate-500 rounded-lg px-4 py-2 text-sm outline-none transition"
          autocomplete="off"
        />
        <ul
          id="dropdown1"
          class="absolute z-10 w-full bg-slate-900 border border-slate-700 rounded-lg mt-1 hidden max-h-60 overflow-y-auto"
        ></ul>
      </div>
    </div>
  </section>

  <!-- Game 2 -->
  <section id="game_card_2" class="flex-1 bg-slate-800 text-slate-100 rounded-xl shadow-lg border border-slate-700 rounded-lg">
    <img src="../assets/images/no-cover.png" alt="" class="w-full h-48 object-cover rounded-lg" id="gameImg2"/>
    <div class="px-5 py-2 flex flex-col gap-3">
      <h2 id="gameName2" class="text-lg font-bold text-white">Game Naam</h2>
      <ul class="flex flex-col gap-1.5 text-sm text-slate-400">
        <li id="gameGenre2">Genre</li>
        <li id="gameRelease2">Release</li>
        <li id="gamePlatform2">Platform</li>
        <li id="gameRating2" class="text-amber-400 font-semibold">Rating</li>
      </ul>
      <!-- Dropdown -->
      <div class="relative">
        <input
          type="search"
          id="searchInput2"
          placeholder="Zoek een game..."
          class="mt-1 w-full bg-slate-900 text-slate-100 placeholder-slate-500 rounded-lg px-4 py-2 text-sm outline-none transition"
          autocomplete="off"
        />
        <ul
          id="dropdown2"
          class="absolute z-10 w-full bg-slate-900 border border-slate-700 rounded-lg mt-1 hidden max-h-60 overflow-y-auto"
        ></ul>
      </div>
    </div>
  </section>

</main>

<!-- Stats vergelijking -->
<section id="stats-comparison" class="hidden max-w-6xl mx-auto px-6 mt-6">
  <div class="bg-slate-800 border border-slate-700 rounded-lg p-6">
    <h2 class="text-lg font-bold text-white mb-4">Vergelijking</h2>
      <table class="w-full text-sm table-fixed">
        <thead>
          <tr class="text-slate-400">
            <th class="text-left py-2 w-1/3" id="stat-name1">Game 1</th>
            <th class="text-center py-2 w-1/3">Stat</th>
            <th class="text-right py-2 w-1/3" id="stat-name2">Game 2</th>
          </tr>
        </thead>
        <tbody id="stats-body"></tbody>
      </table>
  </div>
</section>

<%- include ('partials/footer') %>