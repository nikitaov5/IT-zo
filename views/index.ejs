<%- include ('partials/header') %>

<title>Index</title>

<script type="module" src="/scripts/index/index.js" defer></script>

<body class="min-h-screen w-full bg-slate-900 text-slate-100 flex flex-col">

  <!-- HEADER -->
  <header
    class="fixed top-0 left-0 right-0 z-50 h-16 bg-slate-200 text-slate-800 border-b border-slate-300"
  >
    <div
      class="h-full max-w-7xl mx-auto flex items-center justify-between px-4 sm:px-6"
    >
      <h1 class="text-lg sm:text-xl font-bold">
        IT&Zo Hub
      </h1>

      <nav class="flex items-center gap-2 sm:gap-3">
        <a
          href="/register"
          class="px-4 py-2 rounded-lg hover:bg-slate-300 transition"
        >
          Registreren
        </a>

        <a
          href="/login"
          class="px-4 py-2 rounded-lg hover:bg-slate-300 transition"
        >
          Inloggen
        </a>
      </nav>
    </div>
  </header>

  <!-- MAIN -->
  <main class="flex-1 pt-24 px-4 sm:px-6 lg:px-8 pb-10">
    <section class="max-w-7xl mx-auto">
      
      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold text-slate-100 mb-3">
          IT&Zo Hub
        </h1>

        <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto">
          Ontdek verschillende projecten en apps gemaakt binnen IT&Zo.
        </p>
      </div>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8"
      >
        <!-- CARD -->
        <a
          href="/unavailable"
          class="group bg-slate-800 border border-slate-700 rounded-2xl p-6 flex flex-col items-center text-center shadow-xl hover:border-indigo-500 hover:scale-[1.02] transition"
        >
          <img
            src="./assets/images/spotify.png"
            alt="MusicMatch"
            class="w-28 h-28 sm:w-36 sm:h-36 object-contain rounded-full mb-5"
          />

          <h2 class="text-lg sm:text-xl font-bold text-slate-100 mb-2">
            MusicMatch
          </h2>

          <p class="text-slate-400 text-sm mb-4">
            Ontdek muziek en match met jouw favoriete tracks.
          </p>

          <span
            class="mt-auto text-indigo-400 group-hover:underline text-sm"
          >
            Meer zien
          </span>
        </a>

        <!-- CARD -->
        <a
          href="/unavailable"
          class="group bg-slate-800 border border-slate-700 rounded-2xl p-6 flex flex-col items-center text-center shadow-xl hover:border-indigo-500 hover:scale-[1.02] transition"
        >
          <img
            src="./assets/images/gamehub.png"
            alt="GameHub"
            class="w-28 h-28 sm:w-36 sm:h-36 object-contain rounded-full mb-5"
          />

          <h2 class="text-lg sm:text-xl font-bold text-slate-100 mb-2">
            GameHub
          </h2>

          <p class="text-slate-400 text-sm mb-4">
            Browse, vergelijk en beheer jouw favoriete games.
          </p>

          <span
            class="mt-auto text-indigo-400 group-hover:underline text-sm"
          >
            Meer zien
          </span>
        </a>

        <!-- CARD -->
        <a
          href="/unavailable"
          class="group bg-slate-800 border border-slate-700 rounded-2xl p-6 flex flex-col items-center text-center shadow-xl hover:border-indigo-500 hover:scale-[1.02] transition"
        >
          <img
            src="./assets/images/lego.png"
            alt="LegoMaster"
            class="w-28 h-28 sm:w-36 sm:h-36 object-contain rounded-full mb-5"
          />

          <h2 class="text-lg sm:text-xl font-bold text-slate-100 mb-2">
            LegoMaster
          </h2>

          <p class="text-slate-400 text-sm mb-4">
            Bouw en ontdek creatieve LEGO projecten en sets.
          </p>

          <span
            class="mt-auto text-indigo-400 group-hover:underline text-sm"
          >
            Meer zien
          </span>
        </a>
      </div>
    </section>
  </main>
<%- include ('partials/footer') %>
