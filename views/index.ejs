<%- include ('partials/header') %>  
<title>Index</title>
</head>

<body class="min-h-screen w-full bg-slate-900 text-slate-100 flex flex-col">

<header
      class="bg-slate-200 text-slate-800 flex flex-col sm:flex-row items-center gap-3 sm:gap-4 px-4 py-4"
    >
      <h1 class="text-lg sm:text-xl font-bold">
        IT&Zo Hub
      </h1>

      <nav class="flex flex-wrap justify-center gap-2 sm:gap-3 sm:ml-auto">
        <a
          href="/"
          class="bg-black text-white px-4 py-2 rounded"
        >
          Home
        </a>

        <a
          href="/register"
          class="px-4 py-2 rounded hover:bg-slate-300 transition"
        >
          Registreren
        </a>

        <a
          href="/login"
          class="px-4 py-2 rounded hover:bg-slate-300 transition"
        >
          Inloggen
        </a>
      </nav>
    </header>

<main class="flex-1 mt-8 sm:mt-12 lg:mt-16 px-4 sm:px-8 lg:px-16 pb-10">

  <section
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 lg:gap-10 justify-items-center"
  >

    <!-- CARD -->
    <a href="/unavailable" class="text-sm hover:underline w-full flex justify-center">
      <article class="flex flex-col items-center gap-3 hover:scale-105 transition">
        <figure class="w-40 sm:w-48">
          <img
            src="./assets/images/spotify.png"
            alt="MusicMatch"
            class="w-28 h-28 sm:w-36 sm:h-36 object-contain mx-auto rounded-full"
          />
          <figcaption class="mt-3 text-base sm:text-lg text-center">
            MusicMatch
          </figcaption>
        </figure>
        <p>Meer zien</p>
      </article>
    </a>

    <!-- CARD -->
    <a href="/unavailable" class="text-sm hover:underline w-full flex justify-center">
      <article class="flex flex-col items-center gap-3 hover:scale-105 transition">
        <figure class="w-40 sm:w-48">
          <img
            src="./assets/images/gamehub.png"
            alt="GameHub"
            class="w-28 h-28 sm:w-36 sm:h-36 object-contain mx-auto rounded-full"
          />
          <figcaption class="mt-3 text-base sm:text-lg text-center">
            GameHub
          </figcaption>
        </figure>
        <p>Meer zien</p>
      </article>
    </a>

    <!-- CARD -->
    <a href="/unavailable" class="text-sm hover:underline w-full flex justify-center">
      <article class="flex flex-col items-center gap-3 hover:scale-105 transition">
        <figure class="w-40 sm:w-48">
          <img
            src="./assets/images/lego.png"
            alt="LegoMaster"
            class="w-28 h-28 sm:w-36 sm:h-36 object-contain mx-auto rounded-full"
          />
          <figcaption class="mt-3 text-base sm:text-lg text-center">
            LegoMaster
          </figcaption>
        </figure>
        <p>Meer zien</p>
      </article>
    </a>

  </section>

</main>

</body>
</html>