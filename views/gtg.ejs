<%- include ('partials/header') %>
<title>GTG</title>

<script type="module" src="/scripts/gtg/gtg.js" defer></script>

<%- include ('partials/navigation') %>

<!-- MAIN -->
<main class="max-w-5xl mx-auto px-3 sm:px-4 md:px-6 pt-24 flex flex-col flex-1 gap-4">
  
  <section
    id="game"
    class="w-full bg-black rounded-lg shadow outline-white overflow-hidden"
    style="aspect-ratio: 16/9; max-height: 360px"
  >
    <!-- Foto hier injecteren -->
  </section>

  <input
    id="guess-input"
    type="text"
    placeholder="Welke game is het? Druk enter om een poging te wagen!"
    class="w-full text-sm sm:text-base bg-gray-100 text-black placeholder-gray-400 rounded-full px-4 sm:px-5 py-3 outline-none border border-gray-200 focus:border-blue-400 transition"
  />

  <!-- Score -->
<div
  class="max-w-6xl mx-auto w-full px-2 sm:px-4 py-1 flex items-center justify-center gap-2"
>
  <span>Score:</span>

  <div class="flex items-center gap-1">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="size-6 hidden"
      id="flame"
    >
      <path
        fill-rule="evenodd"
        d="M12.963 2.286a.75.75 0 0 0-1.071-.136 9.742 9.742 0 0 0-3.539 6.176 7.547 7.547 0 0 1-1.705-1.715.75.75 0 0 0-1.152-.082A9 9 0 1 0 15.68 4.534a7.46 7.46 0 0 1-2.717-2.248ZM15.75 14.25a3.75 3.75 0 1 1-7.313-1.172c.628.465 1.35.81 2.133 1a5.99 5.99 0 0 1 1.925-3.546 3.75 3.75 0 0 1 3.255 3.718Z"
        clip-rule="evenodd"
      />
    </svg>

    <span id="score">0</span>
  </div>
</div>
</main>

<%- include ('partials/footer') %>