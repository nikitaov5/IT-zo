</head>

<body class="flex flex-col min-h-dvh w-full bg-slate-900 text-slate-100 overflow-x-hidden">
<header class="fixed top-0 left-0 right-0 z-50 bg-slate-200 text-slate-800 border-b border-slate-300">
  <div class="max-w-7xl mx-auto px-3 md:px-5 lg:px-8">

    <div class="grid items-center min-h-16
                grid-cols-[auto_1fr_auto] gap-x-3
                py-0
                max-sm:grid-cols-[1fr_auto] max-sm:grid-rows-2 max-sm:gap-y-1.5 max-sm:py-2">

      <!-- LEFT : NAV -->
      <nav class="flex items-center gap-1 md:gap-4 lg:gap-6
                  max-sm:col-start-1 max-sm:row-start-1">
        <a href="/home" class="p-2 rounded-lg hover:bg-slate-300 transition">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </a>

        <a href="/collection" class="p-2 rounded-lg hover:bg-slate-300 transition">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0 0 12 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75Z" />
          </svg>
        </a>

        <a href="/compare" class="p-2 rounded-lg hover:bg-slate-300 transition">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
        </a>

        <a href="/gtg" class="p-2 rounded-lg hover:bg-slate-300 transition">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 md:w-6 md:h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z" />
          </svg>
        </a>

      </nav>

      <!-- CENTER : CURRENT GAME -->
      <div id="currentGame"
           class="<%= currentGame ? 'flex justify-center items-center gap-2 min-w-0 overflow-hidden max-sm:col-start-2 max-sm:row-start-1 max-sm:justify-end' : 'hidden' %>">
        <img id="currentGameImage"
             src="<%= currentGame?.background_image || '' %>"
             class="w-7 h-7 rounded object-cover border border-slate-400 flex-shrink-0"
             alt="<%= currentGame?.name || 'Current Game' %>" />
        <span id="currentGameName"
              class="text-sm font-semibold text-slate-800 truncate max-w-[140px] md:max-w-[200px]">
          <%= currentGame?.name || '' %>
        </span>
      </div>

      <!-- RIGHT : SEARCH -->
      <div class="max-sm:col-span-2 max-sm:row-start-2">
        <div class="relative w-full sm:w-48 lg:w-64">
          <input type="text" id="searchInput" placeholder="Zoek een game..."
                 class="w-full rounded-full bg-slate-100 border border-slate-300
                        px-4 py-1.5 pl-9 text-sm text-slate-800 placeholder-slate-400
                        focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:bg-white transition" />
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
               stroke-width="1.5" stroke="currentColor"
               class="size-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 15.803a7.5 7.5 0 0 0 10.607 0Z"/>
          </svg>
        </div>
      </div>

    </div>
  </div>
</header>